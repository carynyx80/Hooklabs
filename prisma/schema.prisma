generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id           String   @id @default(cuid())
  vaultAddress String   @unique
  tokenAddress String
  tokenSymbol  String
  name         String
  owner        String
  strategy     String   @default("balanced")
  chainId      Int      @default(97)
  deployTx     String?
  status       String   @default("active")
  treasuryBnb  Decimal  @default(0)
  createdAt    DateTime @default(now())
  executions   Execution[]
}

model Execution {
  id            String   @id @default(cuid())
  vaultAddress  String
  agent         Agent    @relation(fields: [vaultAddress], references: [vaultAddress])
  action        String
  amountBnb     Decimal  @default(0)
  amountDisplay String?
  target        String?
  slippageBps   Int      @default(0)
  status        String   // proposed | approved | simulated | submitted | confirmed | failed
  txHash        String?
  reason        String?
  idempotencyKey String  @unique
  confirmations Int      @default(0)
  createdAt     DateTime @default(now())
}
